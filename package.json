{
  "name": "skill-evaluator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drag-and-drop, fully in-browser evaluator for agent skills (SKILL.md). Inspired by NVIDIA SkillEvaluator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node tests/e2e/e2e.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "preact": "10.24.3",
    "yaml": "2.6.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.1",
    "@types/node": "22.9.0",
    "playwright-core": "^1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
